<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GfzCliProgram</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gfz</AssemblyName>
    <ApplicationIcon>gfz-cli-icon.ico</ApplicationIcon>
    <Title>GFZ CLI</Title>
    <Version>0.5.0</Version>
    <PackageIcon>gfz-cli-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/RaphaelTetreault/gfz-cli</RepositoryUrl>
    <StartupObject>GfzCliProgram.Program</StartupObject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>$(NoWarn);SYSLIB1045</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>$(NoWarn);SYSLIB1045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="gfz-cli-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
